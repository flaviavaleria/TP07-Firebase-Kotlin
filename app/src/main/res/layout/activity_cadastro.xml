<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Criar conta" android:textSize="26sp" android:gravity="center" android:layout_marginBottom="24dp" />
<EditText android:id="@+id/emailCadastro" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="E-mail" android:inputType="textEmailAddress" />
<EditText android:id="@+id/senhaCadastro" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Senha (mínimo 6 caracteres)" android:inputType="textPassword" />
<Button android:id="@+id/btnCriarConta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Criar conta" />
</LinearLayout>
